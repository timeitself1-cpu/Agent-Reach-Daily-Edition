# Text files are stored with LF in the repository (checked out with the platform's line endings).
* text=auto
# Windows scripts must keep CRLF line endings (cmd.exe labels and PowerShell 5.1 are picky).
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
# The commit a zip of this repository was made from (git archive and GitHub's zip fill it in; see daily/updater.py).
agent_reach/daily/build.txt export-subst
